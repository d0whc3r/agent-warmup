# agent-warmup — complete multi-provider example
# Live config: ~/.agent-warmup/warmup.env (legacy ~/.claude/warmup is detected).

WARMUP_MODE=smart
WARMUP_SCHEDULER=launchd
WARMUP_TICK_MINUTES=30
WARMUP_PROVIDERS=claude,codex,zai,kimi,opencode,minimax
WARMUP_SELECTED_PROVIDER=claude

# Claude Code (enabled by default)
WARMUP_CLAUDE_ENABLED=true
WARMUP_CLAUDE_BIN=~/.local/bin/claude
WARMUP_CLAUDE_MODEL=haiku
WARMUP_CLAUDE_TMUX_SESSION=claude-warmup
WARMUP_CLAUDE_WORK_START=8
WARMUP_CLAUDE_WORK_END=23
WARMUP_CLAUDE_WEEKLY_STOP_PERCENT=90
WARMUP_CLAUDE_SCHEDULE=8,13,18

# OpenAI Codex (opt-in)
WARMUP_CODEX_ENABLED=false
WARMUP_CODEX_BIN=~/.local/bin/codex
WARMUP_CODEX_MODEL=gpt-5.6-luna
WARMUP_CODEX_TMUX_SESSION=codex-warmup
WARMUP_CODEX_WORK_START=8
WARMUP_CODEX_WORK_END=23
WARMUP_CODEX_WEEKLY_STOP_PERCENT=85
WARMUP_CODEX_SCHEDULE=8,13,18

# Z.AI GLM Coding Plan through OpenCode (opt-in)
WARMUP_ZAI_ENABLED=false
WARMUP_ZAI_BIN=~/.opencode/bin/opencode
WARMUP_ZAI_MODEL=zai-coding-plan/glm-5.3-flash
WARMUP_ZAI_TMUX_SESSION=zai-warmup
WARMUP_ZAI_WORK_START=8
WARMUP_ZAI_WORK_END=23
WARMUP_ZAI_WEEKLY_STOP_PERCENT=85
WARMUP_ZAI_SCHEDULE=8,13,18

# Kimi Code (opt-in)
WARMUP_KIMI_ENABLED=false
WARMUP_KIMI_BIN=~/.kimi-code/bin/kimi
WARMUP_KIMI_MODEL=kimi-code/kimi-for-coding
WARMUP_KIMI_TMUX_SESSION=kimi-warmup
WARMUP_KIMI_WORK_START=8
WARMUP_KIMI_WORK_END=23
WARMUP_KIMI_WEEKLY_STOP_PERCENT=85
WARMUP_KIMI_SCHEDULE=8,13,18

# OpenCode Go (opt-in)
WARMUP_OPENCODE_ENABLED=false
WARMUP_OPENCODE_BIN=~/.opencode/bin/opencode
WARMUP_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
WARMUP_OPENCODE_TMUX_SESSION=opencode-warmup
WARMUP_OPENCODE_WORK_START=8
WARMUP_OPENCODE_WORK_END=23
WARMUP_OPENCODE_WEEKLY_STOP_PERCENT=85
WARMUP_OPENCODE_SCHEDULE=8,13,18

# MiniMax Token Plan through OpenCode (opt-in)
WARMUP_MINIMAX_ENABLED=false
WARMUP_MINIMAX_BIN=~/.opencode/bin/opencode
WARMUP_MINIMAX_MODEL=minimax-coding-plan/MiniMax-M2.7
WARMUP_MINIMAX_TMUX_SESSION=minimax-warmup
WARMUP_MINIMAX_WORK_START=8
WARMUP_MINIMAX_WORK_END=23
WARMUP_MINIMAX_WEEKLY_STOP_PERCENT=85
WARMUP_MINIMAX_SCHEDULE=8,13,18

# Optional runtime-only overrides (not persisted by the CLI)
# WARMUP_PROMPT=reply with only the word: ok
# WARMUP_HOME=~/.agent-warmup
# WARMUP_WORKDIR=~/.agent-warmup/workdir
# WARMUP_READY_WAIT=10
# WARMUP_RESPONSE_WAIT=25
# WARMUP_LOG_RETENTION_DAYS=14
# TMUX_BIN=/opt/homebrew/bin/tmux
