# claude-warmup — example configuration (multi-provider schema)
#
# The CLI stores your live settings at ~/.claude/warmup/warmup.env in exactly
# this format. You normally don't edit that file by hand — `claude-warmup mode`,
# `model`, `provider`, etc. rewrite it for you. This file documents every key so
# you can see what's configurable; copy it to ~/.claude/warmup/warmup.env to seed
# the defaults, then run `claude-warmup restart` to apply.
#
# Values shown are the defaults. The legacy flat schema (WARMUP_MODE / WARMUP_MODEL /
# WARMUP_SCHEDULE / WARMUP_WORK_START / …) is still recognized on read; on the
# first save the file is rewritten in this multi-provider shape, with a
# warmup.env.bak dropped next to it for rollback.

# ── Shared (top-level) ──────────────────────────────────────────────────────

# smart | fixed  — smart probes each provider's /usage and arms only when needed
WARMUP_MODE=smart

# launchd | cron  — which scheduler installs the timers
WARMUP_SCHEDULER=launchd

# how often the smart tick probes + decides, 5 | 10 | 15 | 20 | 30 | 60
WARMUP_TICK_MINUTES=30

# CSV of provider ids, in the order the tick iterates them. The first enabled
# id is the default selected provider (which the unprefixed subcommands mutate).
WARMUP_PROVIDERS=claude,opencode
WARMUP_SELECTED_PROVIDER=claude

# ── Provider: claude ─────────────────────────────────────────────────────────

WARMUP_CLAUDE_ENABLED=true
WARMUP_CLAUDE_BIN=~/.local/bin/claude
WARMUP_CLAUDE_MODEL=haiku
WARMUP_CLAUDE_TMUX_SESSION=claude-warmup
WARMUP_CLAUDE_WORK_START=8
WARMUP_CLAUDE_WORK_END=23
WARMUP_CLAUDE_WEEKLY_STOP_PERCENT=90
# fixed mode only:
# WARMUP_CLAUDE_SCHEDULE=8,13,18

# ── Provider: opencode (OpenCode Go) ────────────────────────────────────────
# Go has a 3-tier rolling window: $12/5h, $30/week, $60/month. The 5h
# session-active is NOT queryable from the CLI today (opencode issue #19190
# in flight), so the tick falls back to "did we arm in the last 5h?". The
# weekly % is derived from `opencode stats --days 7`. Default model is
# the cheapest on Go (31.6k req/5h, ~$0.0004 per warmup).

WARMUP_OPENCODE_ENABLED=true
WARMUP_OPENCODE_BIN=~/.opencode/bin/opencode
WARMUP_OPENCODE_MODEL=opencode-go/deepseek-v4-flash
WARMUP_OPENCODE_TMUX_SESSION=opencode-warmup
WARMUP_OPENCODE_WORK_START=7
WARMUP_OPENCODE_WORK_END=22
WARMUP_OPENCODE_WEEKLY_STOP_PERCENT=85
# fixed mode only:
# WARMUP_OPENCODE_SCHEDULE=9,14,19

# ── Extra knobs read only by the arm scripts ───────────────────────────────
# NOT persisted by the CLI (it rewrites warmup.env from the keys above and drops
# anything else). Set these in your shell or the scheduler env to tune manual
# runs. Uncomment to override the built-in defaults.

# WARMUP_PROMPT=reply with only the word: ok   # trivial prompt that arms the window
# WARMUP_HOME=~/.claude/warmup                 # root dir for config + logs + workdir
# WARMUP_WORKDIR=~/.claude/warmup/workdir      # trusted dir the session runs in
# WARMUP_READY_WAIT=10                         # sec to wait for the TUI to start
# WARMUP_RESPONSE_WAIT=25                      # sec to wait for the model's reply
# WARMUP_LOG_DIR=~/.claude/warmup/logs         # log directory
# WARMUP_LOG_RETENTION_DAYS=14                 # delete logs/captures older than this
# CLAUDE_BIN=~/.local/bin/claude               # path to the claude binary
# OPENCODE_BIN=~/.opencode/bin/opencode        # path to the opencode binary
# TMUX_BIN=/opt/homebrew/bin/tmux              # path to the tmux binary
